rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email == 'info@9works.kr'
          || firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        );
    }

    function portalIsEnabled(portalKey) {
      return firestore.exists(/databases/(default)/documents/clientPortals/$(portalKey))
        && firestore.get(/databases/(default)/documents/clientPortals/$(portalKey)).data.enabled == true;
    }

    function portalFileIsVisible(portalKey, fileId) {
      return firestore.exists(/databases/(default)/documents/clientPortals/$(portalKey)/files/$(fileId));
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /members/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /private/{allPaths=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Client Portal: 관리자 업로드는 파일당 50MB까지,
    // 공개된 portal + 공개된 file metadata가 모두 있을 때만 고객 열람을 허용합니다.
    match /client-portals/{portalKey}/{clientId}/{fileId}/{fileName} {
      allow read: if isAdmin() || (portalIsEnabled(portalKey) && portalFileIsVisible(portalKey, fileId));
      allow create, update: if isAdmin() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
