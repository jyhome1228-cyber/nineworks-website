rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'info@9works.kr';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /portfolios/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /projects/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /magazines/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    // NINEWORKS Members profile.
    // 계정 소유자는 자신의 기본 프로필만 수정할 수 있고,
    // status / clientId / clientLinkedAt 같은 관리 필드는 관리자만 변경합니다.
    match /members/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'name', 'role', 'creatorType', 'organization', 'phone',
          'website', 'partnerCategory', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'role', 'creatorType', 'organization', 'phone',
          'website', 'partnerCategory', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['client', 'creator', 'partner']
        && (
          (request.resource.data.role == 'partner' && request.resource.data.status == 'pending')
          || (request.resource.data.role != 'partner' && request.resource.data.status == 'active')
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name', 'creatorType', 'organization', 'phone', 'website', 'partnerCategory', 'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    // 향후 관리자에서 등록하는 멤버 전용 자료 메타데이터
    match /resources/{documentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.published == true);
      allow write: if isAdmin();
    }

    // 홈페이지 문의: 방문자는 신규 등록만, 관리자는 조회/수정/삭제 가능
    match /inquiries/{documentId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'status', 'source', 'service', 'company', 'contactName', 'email',
          'phone', 'projectName', 'projectType', 'message', 'details',
          'pageTitle', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'status', 'source', 'service', 'company', 'contactName', 'email',
          'phone', 'projectName', 'projectType', 'message', 'details',
          'pageTitle', 'createdAt'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // 방문자 기록: 브라우저별 하루 1회 생성, 조회는 관리자만 가능
    match /dailyVisitors/{visitId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'date', 'visitorId', 'firstPath', 'referrer', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'date', 'visitorId', 'firstPath', 'referrer', 'createdAt'
        ])
        && visitId == request.resource.data.date + '_' + request.resource.data.visitorId
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    match /clients/{documentId} {
      allow read, write: if isAdmin();
    }

    match /tasks/{documentId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
