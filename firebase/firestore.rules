rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'info@9works.kr';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isKnownPartnerEmail(email) {
      return email in [
        'seodw100@naver.com',
        's.nninyong@gmail.com',
        'daytuio0329@naver.com'
      ];
    }

    match /portfolios/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /projects/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /magazines/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /members/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'name', 'role', 'creatorType', 'organization', 'phone',
          'website', 'partnerCategory', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'role', 'creatorType', 'organization', 'phone',
          'website', 'partnerCategory', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['client', 'creator', 'partner']
        && (
          (request.resource.data.role == 'partner' && request.resource.data.status == 'pending')
          || (request.resource.data.role != 'partner' && request.resource.data.status == 'active')
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name', 'creatorType', 'organization', 'phone', 'website', 'partnerCategory', 'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    match /resources/{documentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.published == true);
      allow write: if isAdmin();
    }

    match /inquiries/{documentId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'status', 'source', 'service', 'company', 'contactName', 'email',
          'phone', 'projectName', 'projectType', 'message', 'details',
          'pageTitle', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'status', 'source', 'service', 'company', 'contactName', 'email',
          'phone', 'projectName', 'projectType', 'message', 'details',
          'pageTitle', 'createdAt'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    match /partners/{partnerKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /partnerWorkspaces/{partnerKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /partnerAccountSubmissions/{documentId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'partnerEmail', 'partnerName', 'paymentType', 'accountHolder', 'bank', 'accountNumber',
          'source', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'partnerEmail', 'partnerName', 'paymentType', 'accountHolder', 'bank', 'accountNumber',
          'source', 'createdAt'
        ])
        && isKnownPartnerEmail(request.resource.data.partnerEmail)
        && request.resource.data.paymentType in ['freelancer', 'business']
        && request.resource.data.source == 'PARTNER_WORKSPACE'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /partnerProposalFeedback/{documentId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'partnerEmail', 'partnerName', 'inquiryId', 'projectName', 'company',
          'proposalUrl', 'message', 'source', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'partnerEmail', 'partnerName', 'inquiryId', 'projectName', 'company',
          'proposalUrl', 'message', 'source', 'createdAt'
        ])
        && isKnownPartnerEmail(request.resource.data.partnerEmail)
        && request.resource.data.source == 'PARTNER_WORKSPACE'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /dailyVisitors/{visitId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'date', 'visitorId', 'firstPath', 'referrer', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'date', 'visitorId', 'firstPath', 'referrer', 'createdAt'
        ])
        && visitId == request.resource.data.date + '_' + request.resource.data.visitorId
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // 내부 CRM 원본: 관리자 전용. 파일 메타데이터 하위 컬렉션도 포함합니다.
    match /clients/{clientId} {
      allow read, write: if isAdmin();

      match /files/{fileId} {
        allow read, write: if isAdmin();
      }
    }

    // 비밀 링크에 노출할 최소 데이터만 별도 저장합니다.
    match /clientPortals/{portalKey} {
      allow get: if isAdmin() || resource.data.enabled == true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /files/{fileId} {
        allow get, list: if isAdmin()
          || get(/databases/$(database)/documents/clientPortals/$(portalKey)).data.enabled == true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /tasks/{documentId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
